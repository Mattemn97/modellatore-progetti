{
  "name": "modellatore-mbse",
  "productName": "Modellatore MBSE",
  "version": "2.0.0-dev",
  "description": "Modellatore di requisiti a blocchi (MBSE)",
  "private": true,
  "main": "out/main/index.mjs",
  "author": "Matteo Filippini",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron . --dev",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/renderer/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "verifica": "npm run typecheck && npm run lint && npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "esbuild@0.28.2": true
  }
}
